<Window x:Class="Practica_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica_2"
        mc:Ignorable="d"
        Title="Netflix" Height="450" Width="800"
        Background="{StaticResource FondoBrush}" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.Resources>
        <Storyboard x:Key="StoryMenu1"/>
        <Storyboard x:Key="StoryMenuInv1"/>
    </Window.Resources>
    <Grid Background="{StaticResource FondoBrush}">

        <!-- Botón "Volver" del reproductor. Queda bajo el Frame: solo se ve y se puede
             pulsar cuando la página deja su fondo transparente al reproducir un vídeo. -->
        <Button x:Name="BReturn" Content="Volver" Tag="&#xE72B;" Style="{StaticResource MediaControlButtonStyle}" Click="Click"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,14"/>

        <!-- Contenedor de navegación: aquí se carga el catálogo (Page1) -->
        <Frame x:Name="ejemplo" Margin="0,0,0,1" d:IsLocked="True"/>

        <!-- ===== Selección de perfil ===== -->
        <Image Source="/Name logo.png" Height="26" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,20,0,0"
               Visibility="{Binding Visibility, ElementName=texto1}"/>

        <TextBlock x:Name="texto1" Text="¿Quién está viendo ahora?" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,74,0,0"
                   Foreground="White" FontSize="34" FontWeight="SemiBold"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,150,0,0">

            <StackPanel Margin="16,0">
                <Button x:Name="ImageButton" Click="Click" Style="{StaticResource TarjetaButtonStyle}">
                    <Border Width="108" Height="108" CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="/Silco.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Button>
                <TextBlock x:Name="texto2" Text="Eloy" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextoSuaveBrush}" FontSize="15"/>
            </StackPanel>

            <StackPanel Margin="16,0">
                <Button x:Name="ImageButton2" Click="Click" Style="{StaticResource TarjetaButtonStyle}">
                    <Border Width="108" Height="108" CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="/Image3.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Button>
                <TextBlock x:Name="texto3" Text="María" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextoSuaveBrush}" FontSize="15"/>
            </StackPanel>

            <StackPanel Margin="16,0">
                <Button x:Name="ImageButton3" Click="Click" Style="{StaticResource TarjetaButtonStyle}">
                    <Border Width="108" Height="108" CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="/Image5.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Button>
                <TextBlock x:Name="texto4" Text="José" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextoSuaveBrush}" FontSize="15"/>
            </StackPanel>

            <StackPanel Margin="16,0">
                <Button x:Name="ImageButton4" Click="Click" Style="{StaticResource TarjetaButtonStyle}">
                    <Border Width="108" Height="108" CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="/Image4.png" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Button>
                <TextBlock x:Name="texto5" Text="Víctor" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource TextoSuaveBrush}" FontSize="15"/>
            </StackPanel>

        </StackPanel>

        <Button x:Name="Cerrar" Content="Cerrar sesión" Style="{StaticResource ContornoButtonStyle}" Width="170" Height="34"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,334,0,0" Click="CircularButton_Click"/>

        <!-- Confirmación de cierre de sesión -->
        <Popup x:Name="OptionsPopup" Placement="Center" IsOpen="False" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SuperficieBrush}" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="8" Padding="20,18" Width="250">
                <StackPanel>
                    <TextBlock Text="¿Cerrar la sesión?" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Button Content="Cerrar sesión" Style="{StaticResource AccionButtonStyle}" Click="OpenWindow_Click" Height="34" Margin="0,0,0,8"/>
                    <Button Content="Cancelar" Style="{StaticResource ContornoButtonStyle}" Click="ClosePopup_Click" Height="34"/>
                </StackPanel>
            </Border>
        </Popup>

    </Grid>
</Window>
