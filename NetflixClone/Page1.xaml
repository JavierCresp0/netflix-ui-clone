<Page x:Class="Practica_2.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Practica_2"
      mc:Ignorable="d"
      d:DesignHeight="411" d:DesignWidth="784"
      Title="Page1">
    <Page.Resources>
        <!-- Menú lateral: entra y sale deslizándose desde la izquierda -->
        <Storyboard x:Key="StoryMenu">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="00:00:00.35" Value="811">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="StoryMenuInv">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="StoryMenuInv2">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                <SplineDoubleKeyFrame KeyTime="00:00:00.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Elementos que solo existen en modo reproductor: aparecen cuando el catálogo se oculta -->
        <Style x:Key="SoloReproductorStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=Dune}" Value="Hidden">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="MainGrid" Background="{StaticResource FondoBrush}">

        <!-- ================= CATÁLOGO =================
             Todo el bloque sigue la visibilidad de las carátulas, que el código oculta al reproducir. -->
        <Grid Visibility="{Binding Visibility, ElementName=Dune}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra superior -->
            <Button x:Name="ImageButton6" Content="&#xE700;" Style="{StaticResource IconoButtonStyle}" Click="Click"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" ToolTip="Menú"/>
            <Image Source="/Name logo.png" Height="24" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="72,0,0,0"/>
            <Border Width="30" Height="30" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                <Border.Background>
                    <ImageBrush ImageSource="/Silco.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <!-- Título destacado -->
            <Grid Grid.Row="1" Margin="28,0,28,0">
                <Border CornerRadius="8">
                    <Border.Background>
                        <ImageBrush ImageSource="/Dune2.jpg" Stretch="UniformToFill" AlignmentY="Center"/>
                    </Border.Background>
                </Border>
                <!-- Degradado para que el texto se lea sobre la imagen -->
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#F2101010" Offset="0"/>
                            <GradientStop Color="#B3101010" Offset="0.42"/>
                            <GradientStop Color="#00101010" Offset="0.8"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="26,0,0,0" Width="330">
                    <TextBlock Text="DESTACADO" Foreground="{StaticResource RojoBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Dune: Parte Dos" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,2,0,4"/>
                    <TextBlock Text="Paul Atreides se une a los Fremen para vengar a su familia y cambiar el destino de Arrakis."
                               Foreground="#E5E5E5" FontSize="12.5" TextWrapping="Wrap" LineHeight="17"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Reproducir" Tag="&#xE768;" Style="{StaticResource AccionButtonStyle}" Background="White" Foreground="Black" Height="34" Click="show"/>
                        <Button Content="Más información" Tag="&#xE946;" Style="{StaticResource AccionButtonStyle}" Background="#99555555" Height="34" Margin="10,0,0,0" Click="Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Fila de títulos -->
            <StackPanel Grid.Row="2" Margin="28,12,28,12">
                <TextBlock Text="Tendencias ahora" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="3,0,0,6"/>
                <UniformGrid Columns="3" Margin="-7,0">
                    <StackPanel Margin="7,0">
                        <Button x:Name="Dune" Click="show" Style="{StaticResource TarjetaButtonStyle}">
                            <Border Height="112" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Dune2.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Button>
                        <TextBlock Text="Dune: Parte Dos" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="4,5,0,0"/>
                        <TextBlock Text="2024 · Ciencia ficción" Foreground="{StaticResource TextoSuaveBrush}" FontSize="11" Margin="4,1,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="7,0">
                        <Button x:Name="Arcane" Click="show2" Style="{StaticResource TarjetaButtonStyle}">
                            <Border Height="112" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/arcane.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Button>
                        <TextBlock Text="Arcane" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="4,5,0,0"/>
                        <TextBlock Text="2021 · Animación" Foreground="{StaticResource TextoSuaveBrush}" FontSize="11" Margin="4,1,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="7,0">
                        <Button x:Name="Gladiator" Click="show3" Style="{StaticResource TarjetaButtonStyle}">
                            <Border Height="112" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/gladiator.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Button>
                        <TextBlock Text="Gladiator" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="4,5,0,0"/>
                        <TextBlock Text="2000 · Acción" Foreground="{StaticResource TextoSuaveBrush}" FontSize="11" Margin="4,1,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- ================= REPRODUCTOR ================= -->
        <!-- Pantalla: fondo negro tras el vídeo -->
        <Border Style="{StaticResource SoloReproductorStyle}" Background="Black" VerticalAlignment="Top" Height="344"/>

        <!-- Dune: Parte Dos -->
        <MediaElement x:Name="MEdaredevil" VerticalAlignment="Top" Height="344"/>
        <Button x:Name="play" Content="Play" Tag="&#xE768;" Style="{StaticResource MediaControlButtonStyle}" Click="playDaredevil" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="144,0,0,13"/>
        <Button x:Name="pause" Content="Pausa" Tag="&#xE769;" Style="{StaticResource MediaControlButtonStyle}" Click="pausarVideo" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="264,0,0,13"/>
        <Button x:Name="stop" Content="Stop" Tag="&#xE71A;" Style="{StaticResource MediaControlButtonStyle}" Click="stopDaredevil" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="384,0,0,13"/>

        <!-- Arcane -->
        <MediaElement x:Name="MEdaredevil2" VerticalAlignment="Top" Height="344" d:IsLocked="True"/>
        <Button x:Name="play2" Content="Play" Tag="&#xE768;" Style="{StaticResource MediaControlButtonStyle}" Click="playDaredevil2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="144,0,0,13"/>
        <Button x:Name="pause2" Content="Pausa" Tag="&#xE769;" Style="{StaticResource MediaControlButtonStyle}" Click="pausarVideo2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="264,0,0,13"/>
        <Button x:Name="stop2" Content="Stop" Tag="&#xE71A;" Style="{StaticResource MediaControlButtonStyle}" Click="stopDaredevil2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="384,0,0,13"/>

        <!-- Gladiator -->
        <MediaElement x:Name="MEdaredevil3" VerticalAlignment="Top" Height="344"/>
        <Button x:Name="play3" Content="Play" Tag="&#xE768;" Style="{StaticResource MediaControlButtonStyle}" Click="playDaredevil3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="144,0,0,13"/>
        <Button x:Name="pause3" Content="Pausa" Tag="&#xE769;" Style="{StaticResource MediaControlButtonStyle}" Click="pausarVideo3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="264,0,0,13"/>
        <Button x:Name="stop3" Content="Stop" Tag="&#xE71A;" Style="{StaticResource MediaControlButtonStyle}" Click="stopDaredevil3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="384,0,0,13"/>

        <!-- Volumen: un control por vídeo, enlazado a su MediaElement -->
        <TextBlock Style="{StaticResource SoloReproductorStyle}" Text="&#xE767;" FontFamily="{StaticResource IconosFont}" FontSize="17" Foreground="{StaticResource TextoSuaveBrush}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,190,24"/>
        <Slider x:Name="VolumeSlider" Style="{StaticResource VolumenSliderStyle}" Minimum="0" Maximum="1" Value="{Binding ElementName=MEdaredevil, Path=Volume}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,24"/>
        <Slider x:Name="VolumeSlider2" Style="{StaticResource VolumenSliderStyle}" Minimum="0" Maximum="1" Value="{Binding ElementName=MEdaredevil2, Path=Volume}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,24"/>
        <Slider x:Name="VolumeSlider3" Style="{StaticResource VolumenSliderStyle}" Minimum="0" Maximum="1" Value="{Binding ElementName=MEdaredevil3, Path=Volume}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,24"/>

        <!-- ================= MENÚ LATERAL =================
             Empieza fuera de la pantalla (margen negativo) y la animación lo desplaza hacia dentro. -->
        <Grid x:Name="grid" Margin="-811,0,811,0" RenderTransformOrigin="0.5,0.5" Visibility="{Binding Visibility, ElementName=Dune}">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Fondo oscurecido: pulsarlo cierra el menú -->
            <Button Click="Click2" Cursor="Hand" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="#B3000000"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Panel -->
            <Border Width="250" HorizontalAlignment="Left" Background="#F5181818" BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <Grid DockPanel.Dock="Top" Height="52">
                        <Image Source="/Name logo.png" Height="24" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <Button Content="&#xE711;" Style="{StaticResource IconoButtonStyle}" FontSize="14" Width="34" Height="34" Click="Click2"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Cerrar menú"/>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="CATÁLOGO" Foreground="#808080" FontSize="11" FontWeight="Bold" Margin="20,14,0,6"/>
                    <Button DockPanel.Dock="Top" Content="Dune: Parte Dos" Style="{StaticResource MenuItemButtonStyle}" Click="show"/>
                    <Button DockPanel.Dock="Top" Content="Arcane" Style="{StaticResource MenuItemButtonStyle}" Click="show2"/>
                    <Button DockPanel.Dock="Top" Content="Gladiator" Style="{StaticResource MenuItemButtonStyle}" Click="show3"/>

                    <Border DockPanel.Dock="Bottom" Margin="16,0,16,18" Padding="14,12" CornerRadius="6" Background="#262626">
                        <StackPanel>
                            <TextBlock Text="¿Sabías que…?" Foreground="{StaticResource RojoBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Foreground="#E5E5E5" FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                       Text="Hans Zimmer compuso la banda sonora de Dune y de Gladiator, además de otros grandes éxitos como El Rey León."/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
