<Window x:Class="Practica_2.log"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica_2"
        mc:Ignorable="d"
        Title="log" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Fondo.jpg"/>
        </Grid.Background>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

            <Rectangle HorizontalAlignment="Left" Height="281" Stroke="Black" VerticalAlignment="Center" Width="273">
                <Rectangle.Fill>
                    <SolidColorBrush Color="Black" Opacity="0.5"/>
                </Rectangle.Fill>
            </Rectangle>

            <TextBlock HorizontalAlignment="Left" Height="50" Margin="29,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="122" Foreground="White" FontSize="30"><Run Language="es-es" Text="Sign In"/><LineBreak/><Run Language="es-es"/><Run Text="n"/><LineBreak/><Run/></TextBlock>
            
            <PasswordBox x:Name="txtPassword" HorizontalAlignment="Center" Height="32" Margin="0,133,0,0" VerticalAlignment="Top" Width="215" Background="#FF362E2E" Foreground="White" BorderBrush="{x:Null}"/>
            <Button Content="Sign In" HorizontalAlignment="Center" Height="32" Margin="0,197,0,0" VerticalAlignment="Top" Width="215" Background="#FF920000" Foreground="White" Click="IdentificarUser" BorderBrush="{x:Null}"/>
            <TextBox x:Name="txtUsuario" HorizontalAlignment="Center" Height="32" Margin="0,73,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="215" Background="#FF362E2E" BorderBrush="{x:Null}" Foreground="White"/>
        </Grid>
        <Image Margin="10,10,614,371" Source="/R.png" Stretch="Fill"/>

    </Grid>
</Window>
