<Window x:Class="Practica_2.log"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practica_2"
        mc:Ignorable="d"
        Title="Netflix · Iniciar sesión" Height="450" Width="800"
        Background="{StaticResource FondoBrush}" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid>
        <!-- Fondo: degradado oscuro con un resplandor rojo muy suave -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.9">
                <GradientStop Color="#3A0A0D" Offset="0"/>
                <GradientStop Color="#141414" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Image Source="/Name logo.png" Height="30" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0"/>

        <!-- Tarjeta de inicio de sesión -->
        <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Background="#CC000000" Padding="32,26,32,28" Margin="0,24,0,0">
            <StackPanel>
                <TextBlock Text="Iniciar sesión" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>

                <TextBlock Text="Usuario" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12" Margin="2,0,0,5"/>
                <TextBox x:Name="txtUsuario" Style="{StaticResource CampoTextoStyle}" TextWrapping="NoWrap"/>

                <TextBlock Text="Contraseña" Foreground="{StaticResource TextoSuaveBrush}" FontSize="12" Margin="2,14,0,5"/>
                <PasswordBox x:Name="txtPassword" Style="{StaticResource CampoClaveStyle}"/>

                <Button Content="Iniciar sesión" Style="{StaticResource AccionButtonStyle}" Height="40" Margin="0,24,0,0" Click="IdentificarUser" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
